# Server Configuration
NODE_ENV=development
PORT=3000

# Security Configuration
GHL_WEBHOOK_SECRET=replace_with_strong_random_secret
ADMIN_API_KEY=replace_with_admin_secret

# Downstream Forwarding Configuration
DOWNSTREAM_API_URL=https://api.internal-crm.example.com/v1/leads
DOWNSTREAM_API_KEY=replace_with_strong_random_secret
DOWNSTREAM_SIMULATE_MODE=true

# GoHighLevel API v2 (Bi-Directional Sync)
GHL_API_TOKEN=pit-your-private-integration-token
GHL_LOCATION_ID=your-sub-account-location-id

# Alerting Configuration (Optional Slack / Discord Incoming Webhook URL)
ALERT_WEBHOOK_URL=

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
INITIAL_BACKOFF_MS=500

# Logging
LOG_LEVEL=info
